{
  "name": "@oracledesk/x402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx server.ts",
    "test": "tsx --test *.test.ts",
    "coverage": "c8 --all --src . --reporter=lcovonly --reporter=text-summary --report-dir ../coverage/x402 --exclude '**/*.test.ts' --exclude 'node_modules/**' --exclude 'dist/**' --exclude '**/*.d.ts' tsx --test *.test.ts"
  },
  "dependencies": {
    "@oracledesk/bindings-reasoning-registry": "file:../packages/bindings/reasoning-registry",
    "@x402/core": "^2.23.0",
    "@x402/express": "^2.23.0",
    "@x402/stellar": "^2.23.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "c8": "^12.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3"
  }
}
