# Copy to .env and fill in. Never commit the real file (it's gitignored).
# Testnet only — nothing here should ever point at mainnet or hold real funds.

# --- Stellar network -----------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Portion of each trading fee kept by the protocol treasury (bps), set on
# market-core at deploy time. The remainder accrues to the market creator
# and is claimable before resolution (see docs/architecture.md). 10000
# keeps everything protocol-side, matching pre-#8 deployments.
PROTOCOL_FEE_SHARE_BPS=10000

# Identities used by scripts/deploy-testnet.sh, scripts/seed-market.sh, and
# the agents (see agents/stellar/). Generate with:
#   stellar keys generate oracledesk-deployer --network testnet --fund
#   stellar keys generate oracledesk-agent --network testnet --fund
DEPLOYER_IDENTITY=oracledesk-deployer
AGENT_IDENTITY=oracledesk-agent

# --- Treasury (scripts/deploy-testnet.sh) -----------------------------------
# The treasury keeps a registry of agents, each with roles and its own
# sub-budget under the global caps. deploy-testnet.sh registers the
# constructor agent (oracledesk-agent, all roles) plus a maker
# (oracledesk-maker: create + settle) and a trader (oracledesk-trader:
# trade + settle). Adding agents is a loosening change, so the maker and
# trader go live only after CONFIG_DELAY: re-run the deploy script then.
# CONFIG_DELAY=86400
# MAKER_MAX_TRADE=2000000000
# MAKER_MAX_DAILY=5000000000
# TRADER_MAX_TRADE=2000000000
# TRADER_MAX_DAILY=5000000000

# --- Deployed contract addresses ------------------------------------------
# Populated by scripts/deploy-testnet.sh into deployments/<network>.json
# (testnet by default, local when NETWORK=local). Only set these to override.
# DEPLOYMENTS_PATH selects a different record for the agents:
# DEPLOYMENTS_PATH=deployments/local.json
# MARKET_CORE_CONTRACT_ID=
# RESOLVER_CONTRACT_ID=
# TREASURY_CONTRACT_ID=
# REASONING_REGISTRY_CONTRACT_ID=
# USDC_CONTRACT_ID=

# --- x402 trace API (x402/) ------------------------------------------------
PORT=3001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
TRACE_PRICE_USDC=0.01
# Policy for flagged or revoked traces: "refuse" (410 before payment) or "label" (include verdict)
TRACE_VERDICT_POLICY=refuse
# Static fallback trace records; prefer the reasoning-registry-backed
# repository once REASONING_REGISTRY_CONTRACT_ID is set (see x402/server.ts).
TRACE_RECORDS_JSON=[]
TESTNET_SERVER_STELLAR_ADDRESS=
TESTNET_FACILITATOR_URL=
TESTNET_FACILITATOR_API_KEY=
# Test-harness only: serve registry-backed traces without the x402 payment
# middleware. scripts/e2e-local.sh sets this; never enable it on a paid host.
# PAYMENTS_DISABLED=0
# <!-- TODO(maintainer): confirm the x402-on-Stellar testnet facilitator URL
# to use here; none is hardcoded anywhere in this repo. -->

# --- Agents (agents/) -------------------------------------------------------
# "dry-run" (default, never signs or submits) or "live" (real testnet txs).
AGENT_MODE=dry-run
# Signing keys (S...). Each CLI prefers its own role key and falls back to
# the shared AGENT_SECRET_KEY (the constructor agent, which has every role):
# bin/market-maker.ts reads MAKER_SECRET_KEY, bin/trader.ts TRADER_SECRET_KEY.
# Treasury calls are made as that key's address.
AGENT_SECRET_KEY=
MAKER_SECRET_KEY=
TRADER_SECRET_KEY=
# DEPLOYMENTS_PATH=deployments/testnet.json
# Local E2E / live-trader overrides (see scripts/e2e-local.sh):
# TRADER_MARKET_ID=0
# TRADER_MARKET_YES_BPS=4000
# TRADER_FAIR_VALUE_BPS=6000
# Optional: an off-chain reference price source for the trader's fair-value
# estimate. Read-only; never used for execution (see docs/architecture.md).
POLYMARKET_READ_ONLY_API_URL=
# Execution bounds for real trades (agents/bin/trader.ts). The trader quotes
# first, then sends min_shares_out / limit_price_bps derived from the quote:
# SLIPPAGE_BPS is how far below the quoted average price the fill may land,
# DEADLINE_SECS is how long the signed trade stays valid after submission.
SLIPPAGE_BPS=50
DEADLINE_SECS=60

# --- Agent runtime (agents/bin/agentd.ts, docs/agent-runtime.md) ------------
# AGENT_MODE above must be exactly dry-run or live (anything else exits 2).
# Live state (processed signals, created markets, pending traces) and the
# single-instance lock live here; keep it on persistent storage.
AGENT_STATE_PATH=./.agent-state/state.json
# AGENT_LEASE_PATH=./.agent-state/agent.lock
# AGENT_LEASE=none   # disables the lease; only if exclusivity is guaranteed elsewhere
LEASE_TTL_MS=60000
LEASE_HEARTBEAT_MS=10000
MAKER_INTERVAL_MS=300000
MAKER_JITTER_MS=15000
TRADER_INTERVAL_MS=60000
TRADER_JITTER_MS=5000
# Must be shorter than the supervisor's stop timeout (systemd TimeoutStopSec,
# docker --stop-timeout), or the process is killed mid-submission.
SHUTDOWN_GRACE_MS=30000
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=300000
MAX_CONSECUTIVE_FAILURES=8
MAX_FAILURES_IN_WINDOW=20
FAILURE_WINDOW_MS=600000
STATE_FLUSH_DEBOUNCE_MS=250
MARKET_CLOSE_IN_SECS=3600
# --- Trace storage (agents/core/trace-store-factory.ts) ---------------------
# local (default in dry-run: writes ./.traces, returns unfetchable local://
# "CIDs") or ipfs (default in live mode). Live mode refuses local unless
# ALLOW_LOCAL_TRACE_STORE=1.
TRACE_STORE=
ALLOW_LOCAL_TRACE_STORE=
TRACE_STORE_DIR=./.traces
# The IPFS store computes a raw CIDv1 (sha2-256) itself, so the CID's digest
# equals the on-chain trace_hash, and rejects any provider reporting a
# different CID. It uploads through a kubo node's RPC API (required) and
# optionally also pins by CID on an IPFS Pinning Service API endpoint.
# IPFS_KUBO_AUTH is sent verbatim as the Authorization header (e.g.
# "Basic ..."). Never logged.
IPFS_KUBO_API_URL=
IPFS_KUBO_AUTH=
IPFS_PINNING_ENDPOINT=
IPFS_PINNING_TOKEN=
# Comma-separated multiaddrs of the kubo node, passed as `origins` to the
# pinning service so it can fetch the content quickly.
IPFS_PINNING_ORIGINS=
# Providers that must confirm the pin; 1 = kubo alone is enough.
IPFS_MIN_PINS=1
# Per-attempt timeout (ms) and attempts per provider / gateway check.
IPFS_PIN_TIMEOUT_MS=60000
IPFS_PIN_RETRIES=3
# 1 = count a pinning-service pin that is only queued (accepted, not yet
# confirmed) toward IPFS_MIN_PINS.
IPFS_ACCEPT_QUEUED=0
# Before a CID goes on-chain the agents also GET it from IPFS_GATEWAY_URL
# (the same variable x402 reads, above) and re-check sha256(body).
# --- Market-maker resolution specs (agents/bin/market-maker.ts) -------------
# Every market commits to a real resolution spec, stored durably BEFORE the
# create transaction and revealed right after (docs/adr/0001, "Agent flow
# and recovery"). A lost spec makes its market permanently unresolvable.
# AGENT_SPEC_DIR must be on persistent storage and BACKED UP; it is
# gitignored. SPEC_BACKUP_CMD (optional) runs via the shell after every
# write, with SPEC_DIR and SPEC_FILE set, e.g. `rclone copy "$SPEC_DIR" remote:specs`.
AGENT_SPEC_DIR=./.specs
SPEC_BACKUP_CMD=
# Commitments are computed by scripts/spec-hash. Without SPEC_HASH_BIN it is
# run through `cargo run`, which needs a Rust toolchain at runtime —
# production images should build it (cargo build --release --manifest-path
# scripts/spec-hash/Cargo.toml) and point this at the binary.
SPEC_HASH_BIN=
# SPEC_HASH_MANIFEST=../scripts/spec-hash/Cargo.toml
# 1 = also hash with the TS resolution-spec library and fail on disagreement
# (same as passing --verify-spec-hash).
MM_VERIFY_SPEC_HASH=0
# signers (default) | price
MM_SPEC_MODE=signers
# Comma-separated G.../C... signer addresses; defaults to deployments.agent.
# Order does not matter: signers are sorted (lexicographic strkey) before
# hashing and reveal.
MM_SIGNERS=
MM_SIGNER_THRESHOLD=1
MM_DISPUTE_WINDOW_SECS=600
# Price mode: Reflector contract, asset (stellar:<address> | other:<symbol>),
# threshold (oracle units, >= 0), direction (above | at-or-above | below |
# at-or-below) and the oldest acceptable price. A signal carrying its own
# priceRule overrides asset/threshold/direction.
MM_REFLECTOR=
MM_ASSET=
MM_PRICE_THRESHOLD=
MM_PRICE_DIRECTION=
MM_MAX_STALENESS_SECS=300
# close_time = now + MM_CLOSE_IN_SECS; must exceed now + dispute window +
# MM_CLOSE_MARGIN_SECS.
MM_CLOSE_IN_SECS=3600
MM_CLOSE_MARGIN_SECS=60
# Recovery: abandon a pending create with no matching market after this
# long; how many recent market ids to scan; alert threshold for created
# markets that are still unrevealed.
MM_PENDING_TTL_SECS=900
MM_RECOVERY_MAX_SCAN=200
MM_STALE_REVEAL_SECS=600
